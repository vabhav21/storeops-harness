<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for StoreOps.

  Each exclusion is a deliberate, narrow decision — not a blanket
  silencing. `mvn spotbugs:check` is a Dimension 1 hard gate, so a broad
  exclusion here would quietly weaken the gate.
-->
<FindBugsFilter>

    <!-- JPA entities and DTO records legitimately hand out references to
         their own collections (Project.getMembers()) because Hibernate
         must be able to mutate the managed collection. The invariant this
         detector protects is instead enforced at the service layer, per
         coding-conventions ("the entity setter existing is not permission
         to skip the service-layer check"). -->
    <Match>
        <Or>
            <Package name="~com\.cognizant\.storeops\..*\.model"/>
            <Package name="~com\.cognizant\.storeops\..*\.dto"/>
        </Or>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Event payload records carry a caller-supplied List straight onto
         the bus by design; copying it would break the "payloads are
         records, not entities" contract in coding-conventions without
         adding safety, since payloads are never mutated after emit. -->
    <Match>
        <Package name="~com\.cognizant\.storeops\..*\.service"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Constructor injection of a Spring-managed singleton bean. The
         detector reads "stores an externally mutable object", but the
         container owns the bean's lifecycle and there is nothing to defensively
         copy — a service is a collaborator, not data. This is the layer
         separation rule working as intended (routes hold a service
         reference), so it is excluded only for the injection pattern. -->
    <Match>
        <Package name="~com\.cognizant\.storeops\..*\.routes"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
